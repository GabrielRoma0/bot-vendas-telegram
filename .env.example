# --- Telegram ---
# Token do bot, obtido com o @BotFather
TELEGRAM_BOT_TOKEN=

# ID do chat/canal onde as promoções serão postadas (ex: -1001234567890)
TELEGRAM_CHAT_ID=

# --- Bright Data ---
# API token da sua conta Bright Data (Settings > API keys)
BRIGHTDATA_API_TOKEN=

# ID do dataset "Amazon Products" no Bright Data (Web Scraper API)
# Encontrado no painel do dataset, em "Dataset ID" (formato gd_xxxxxxxxxxxx)
BRIGHTDATA_AMAZON_DATASET_ID=

# --- Afiliados ---
# Tag de afiliado da Amazon (ex: seunome-20)
AMAZON_AFFILIATE_TAG=

# --- Alertas ---
# Queda mínima de preço (%) para disparar um alerta no Telegram
PRICE_DROP_THRESHOLD_PERCENT=15
